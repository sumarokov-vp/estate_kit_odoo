<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_contract_template_view_form" model="ir.ui.view">
        <field name="name">estate.contract.template.form</field>
        <field name="model">estate.contract.template</field>
        <field name="arch" type="xml">
            <form string="Тип договора">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="typst_file"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_contract_template_view_list" model="ir.ui.view">
        <field name="name">estate.contract.template.list</field>
        <field name="model">estate.contract.template</field>
        <field name="arch" type="xml">
            <list string="Типы договоров">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="typst_file"/>
            </list>
        </field>
    </record>

    <record id="estate_contract_template_action" model="ir.actions.act_window">
        <field name="name">Типы договоров</field>
        <field name="res_model">estate.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
